{
  "$schema": "https://schema.tauri.app/config/1.5.0",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../frontend",
    "distDir": "../frontend",
    "frontendDist": "../frontend"
  },
  "package": {
    "productName": "CsRinRu Desktop",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "core": {
        "all": false,
        "path": {
          "all": true,
          "exists": true,
          "readDir": true,
          "readTextFile": true,
          "writeTextFile": true
        },
        "window": {
          "all": true,
          "close": true,
          "hide": true,
          "maximize": true,
          "minimize": true,
          "show": true,
          "unmaximize": true,
          "unminimize": true
        }
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["https://cs.rin.ru/**", "https://api.igdb.com/**", "https://store.steampowered.com/**"]
      }
    },
    "bundle": {
      "active": true,
      "category": "Utility",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.csrinru.desktop",
      "platformSpecific": {
        "windows": {
          "certificateThumbprint": null,
          "digestAlgorithm": "sha256",
          "timestampUrl": ""
        }
      },
      "targets": ["deb", "nsis", "app"]
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'https://cdn.jsdelivr.com'; style-src 'self' 'https://fonts.googleapis.com'; font-src 'self' 'https://fonts.gstatic.com' 'data:'; img-src 'self' data: blob: https://cs.rin.ru https://cdn.jsdelivr.com",
      "externalUrl": [
        "https://cs.rin.ru",
        "https://api.igdb.com"
      ]
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "title": "CsRinRu Desktop - Game Browser",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "transparent": false,
        "decorations": true
      }
    ]
  }
}
